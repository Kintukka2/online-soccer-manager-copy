# Cloudflare Pages response headers.
# https://developers.cloudflare.com/pages/configuration/headers/

# The asset URLs carry the app version (js/app.js?v=0.1.0, written by
# tools/stamp-assets.js), so a cached copy can never be the wrong copy -- the
# URL changes whenever the file does. Cache them for a year.
/css/*
  Cache-Control: public, max-age=31536000, immutable
/js/*
  Cache-Control: public, max-age=31536000, immutable

# The HTML must NOT be cached, and this is the half that makes the stamping
# worth anything: the stamps live in index.html, so if the browser serves a
# cached index.html it never learns the new URLs and keeps its old JS forever.
/
  Cache-Control: public, max-age=0, must-revalidate
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# The service worker must never be served stale. Its bytes are what tell the
# browser a new version exists -- the precache list inside it is rewritten by
# tools/stamp-assets.js on every release -- so a cached copy means the old
# worker keeps serving the old release's cache and no update ever lands.
# Browsers already bypass their HTTP cache for worker scripts, but this is
# too expensive to leave to a default.
/sw.js
  Cache-Control: public, max-age=0, must-revalidate

# The manifest changes rarely, but when it does (a new name, a new shortcut)
# the home screen should hear about it on the next visit rather than in a
# week. It is a kilobyte; revalidating it costs nothing.
/manifest.json
  Cache-Control: public, max-age=0, must-revalidate

# Launcher icons change only when the brand does.
/icon-*.png
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400

# The social card changes only when the brand does, but not under a new name,
# so a short cache keeps a stale crop from sticking around. The pages point at
# it with ?v=<VERSION>, which is what actually moves a share preview on.
/og.png
  Cache-Control: public, max-age=86400

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
